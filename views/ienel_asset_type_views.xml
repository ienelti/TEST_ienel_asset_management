<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Búsqueda -->
    <record id="view_ienel_asset_search" model="ir.ui.view">
        <field name="name">ienel.asset.search</field>
        <field name="model">ienel.asset</field>
        <field name="arch" type="xml">
            <search string="Activos Fijos">
                <field name="name"/>
                <field name="code"/>
                <field name="brand"/>
                <field name="reference"/>
                <field name="asset_type_id"/>
                <field name="person_in_charge_id"/>
                <field name="analytic_account"/>
                <separator/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Tipo de Activo" name="group_asset_type" domain="[]" context="{'group_by': 'asset_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vista de Lista de Tipos de Activos -->
    <record id="view_ienel_asset_type_tree" model="ir.ui.view">
        <field name="name">ienel.asset.type.list</field>
        <field name="model">ienel.asset.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de Activos" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Vista de Formulario de Tipos de Activos -->
    <record id="view_ienel_asset_type_form" model="ir.ui.view">
        <field name="name">ienel.asset.type.form</field>
        <field name="model">ienel.asset.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de Activo">
                <sheet>
                    <group>
                        <field name="name" placeholder="ej. Equipos Técnicos, Vehículos, Muebles..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_ienel_asset_type" model="ir.actions.act_window">
        <field name="name">Tipos de activos</field>
        <field name="res_model">ienel.asset.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Vista Kanban Tablero para Tipos de Activos -->
    <record id="view_ienel_asset_type_kanban" model="ir.ui.view">
        <field name="name">ienel.asset.type.kanban</field>
        <field name="model">ienel.asset.type</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey o_kanban_dashboard o_emphasize_colors" create="0">
                <field name="id"/>
                <field name="name"/>
                <field name="asset_count"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_card_header">
                            <div class="o_kanban_card_header_title">
                                <div class="o_primary fw-bold fs-5">
                                    <a type="object" name="action_open_assets">
                                        <field name="name"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="container o_kanban_card_content mt-3">
                            <div class="row text-center">
                                <div class="col-12">
                                    <a type="object" name="action_open_assets" class="d-flex flex-column align-items-center text-decoration-none">
                                        <span class="fs-2 fw-bold text-primary"><field name="asset_count"/></span>
                                        <span class="text-muted">Activos Registrados</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acción de Ventana para el Tablero Principal -->
    <record id="action_ienel_asset" model="ir.actions.act_window">
        <field name="name">Activos Fijos</field>
        <field name="res_model">ienel.asset</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_ienel_asset_search"/>
    </record>
</odoo>