<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Búsqueda -->
    <record id="view_ienel_asset_search" model="ir.ui.view">
        <field name="name">ienel.asset.search</field>
        <field name="model">ienel.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="brand"/>
                <field name="reference"/>
                <field name="asset_type_id"/>
                <field name="person_in_charge_id"/>
                <field name="analytic_account"/>
                <separator/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                <separator string="Agrupar por"/>
                <group>
                    <filter string="Tipo de Activo" name="group_asset_type" context="{'group_by': 'asset_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vista de Lista -->
    <record id="view_ienel_asset_tree" model="ir.ui.view">
        <field name="name">ienel.asset.list</field>
        <field name="model">ienel.asset</field>
        <field name="arch" type="xml">
            <list string="Activos Fijos">
                <field name="code"/>
                <field name="name"/>
                <field name="brand"/>
                <field name="reference"/>
                <field name="asset_type_id"/>
                <field name="analytic_account"/>
                <field name="person_in_charge_id"/>
            </list>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="view_ienel_asset_kanban" model="ir.ui.view">
        <field name="name">ienel.asset.kanban</field>
        <field name="model">ienel.asset</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center">
                            <div class="me-3 flex-shrink-0" style="width: 80px; height: 80px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                <field name="image" widget="image" class="w-100 h-100 object-fit-cover rounded"/>
                            </div>
                            <div class="flex-grow-1">
                                <strong class="o_kanban_record_title"><field name="code"/> - <field name="name"/></strong>
                                <div><span class="text-muted">Marca / Ref: </span><field name="brand"/> <field name="reference"/></div>
                                <div><span class="text-muted">Tipo de Activo: </span><field name="asset_type_id"/></div>
                                <div><span class="text-muted">Persona a cargo: </span><field name="person_in_charge_id"/></div>
                                <div><span class="text-muted">Cuenta analítica: </span><field name="analytic_account"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Formulario de Registro Detallado -->
    <record id="view_ienel_asset_form" model="ir.ui.view">
        <field name="name">ienel.asset.form</field>
        <field name="model">ienel.asset</field>
        <field name="arch" type="xml">
            <form string="Activo Fijo">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_assignments" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="assignment_count" widget="statinfo" string="Pertenencias"/>
                        </button>
                    </div>
                    <div class="alert alert-warning text-center" role="alert" invisible="not requires_accounting_asset">
                        <strong>¡Atención!</strong> El valor de este activo supera el umbral configurado. Deberá relacionar un activo contable al guardar el registro.
                    </div>
                    <field name="image" widget="image" class="oe_avatar" options="{'prevent_copy': True}"/>
                    
                    <!-- Encabezado: Código Único y Selector de Número de Serie -->
                    <div class="oe_title">
                        <label for="code"/>
                        <h1>
                            <field name="code" placeholder="Código Único" class="text-uppercase"/>
                        </h1>
                        <label for="lot_id" string="Número de serie"/>
                        <h2>
                            <field name="lot_id" placeholder="Seleccionar Número de Serie..."/>
                        </h2>
                    </div>

                    <!-- Grupos reorganizados según el flujo de inventario -->
                    <group>
                        <group string="Información del Activo">
                            <field name="name" string="Descripción"/>
                            <field name="brand" string="Marca"/>
                            <field name="reference" string="Modelo / Referencia"/>
                            <field name="asset_type_id"/>
                            <field name="purchase_value" string="Valor"/>
                            <field name="sale_price" string="Precio de venta"/>
                        </group>
                        <group string="Ubicación y asignaciones">
                            <field name="person_in_charge_id" readonly="1"/>
                            <field name="company_id"/>
                            <field name="location_name" readonly="1"/>
                            <field name="analytic_account"/>
                            <field name="analytic_start_date"/>
                            <field name="active" invisible="1"/>
                            <field name="requires_accounting_asset" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Gestión Documental" name="documents">
                            <field name="document_ids">
                                <list editable="bottom" string="Documentos de la Ficha del Activo">
                                    <field name="doc_type"/>
                                    <field name="file_binary" filename="file_filename" string="Cargar Archivo"/>
                                    <field name="file_filename" column_invisible="True"/>
                                    <field name="name"/>
                                    <field name="upload_user_id" readonly="1"/>
                                    <field name="upload_datetime" readonly="1"/>
                                    <button name="action_open_internal_preview" string="Ver Documento" type="object" icon="fa-eye" invisible="not onedrive_item_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_ienel_asset" model="ir.actions.act_window">
        <field name="name">Activos Fijos</field>
        <field name="res_model">ienel.asset</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>