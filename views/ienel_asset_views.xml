<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Lista -->
    <record id="view_ienel_asset_tree" model="ir.ui.view">
        <field name="name">ienel.asset.list</field>
        <field name="model">ienel.asset</field>
        <field name="arch" type="xml">
            <list string="Activos Fijos">
                <field name="code"/>
                <field name="name"/>
                <field name="brand"/>
                <field name="reference"/>
                <field name="asset_type_id"/>
                <field name="analytic_account"/>
                <field name="person_in_charge"/>
            </list>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="view_ienel_asset_kanban" model="ir.ui.view">
        <field name="name">ienel.asset.kanban</field>
        <field name="model">ienel.asset</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <div class="me-2">
                                <field name="image" widget="image" class="o_kanban_image"/>
                            </div>
                            <div class="flex-grow-1">
                                <strong class="o_kanban_record_title"><field name="code"/> - <field name="name"/></strong>
                                <div><span class="text-muted">Marca / Ref: </span><field name="brand"/> <field name="reference"/></div>
                                <div><span class="text-muted">Tipo de Activo: </span><field name="asset_type_id"/></div>
                                <div><span class="text-muted">Persona a cargo: </span><field name="person_in_charge"/></div>
                                <div><span class="text-muted">Cuenta analítica: </span><field name="analytic_account"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Formulario de Registro Detallado -->
    <record id="view_ienel_asset_form" model="ir.ui.view">
        <field name="name">ienel.asset.form</field>
        <field name="model">ienel.asset</field>
        <field name="arch" type="xml">
            <form string="Activo Fijo">
                <sheet>
                    <div class="alert alert-warning text-center" role="alert" invisible="not requires_accounting_asset">
                        <strong>¡Atención!</strong> El valor de este activo supera el umbral configurado. Deberá relacionar un activo contable al guardar el registro.
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="code" placeholder="Código Único (ej. AF-00001)"/>
                        </h1>
                        <h2>
                            <field name="name" placeholder="Descripción del Activo Fijo"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Información del Activo">
                            <field name="brand"/>
                            <field name="reference"/>
                            <field name="asset_type_id"/>
                            <field name="sale_price"/>
                            <field name="serial_number"/>
                        </group>
                        <group string="Asignación y Custodia">
                            <field name="person_in_charge"/>
                            <field name="employee_start_date"/>
                            <field name="analytic_account"/>
                            <field name="analytic_start_date"/>
                            <field name="company_name"/>
                            <field name="location_name"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Valoración y Umbral Contable">
                        <group>
                            <field name="purchase_value"/>
                            <field name="requires_accounting_asset" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana (Lista, Kanban, Formulario) -->
    <record id="action_ienel_asset" model="ir.actions.act_window">
        <field name="name">Activos Fijos</field>
        <field name="res_model">ienel.asset</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>