<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Búsqueda (Search View) -->
    <record id="view_ienel_asset_search" model="ir.ui.view">
        <field name="name">ienel.asset.search</field>
        <field name="model">ienel.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="product_id"/>
                <field name="serial_id"/>
                <field name="employee_id"/>
                <field name="analytic_account_id"/>
                <field name="product_category_id"/>
                <field name="location_id"/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter string="Categoría de Producto" name="group_category" context="{'group_by': 'product_category_id'}"/>
                    <filter string="Persona a Cargo" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Centro de Costos" name="group_analytic" context="{'group_by': 'analytic_account_id'}"/>
                    <filter string="Ubicación" name="group_location" context="{'group_by': 'location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vista de Lista (List View) -->
    <record id="view_ienel_asset_tree" model="ir.ui.view">
        <field name="name">ienel.asset.list</field>
        <field name="model">ienel.asset</field>
        <field name="arch" type="xml">
            <list string="Activos Fijos">
                <field name="code"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="serial_id"/>
                <field name="employee_id"/>
                <field name="analytic_account_id"/>
                <field name="location_id"/>
                <field name="purchase_value" sum="Total Costo"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Vista de Formulario (Form View) -->
    <record id="view_ienel_asset_form" model="ir.ui.view">
        <field name="name">ienel.asset.form</field>
        <field name="model">ienel.asset</field>
        <field name="arch" type="xml">
            <form string="Activo Fijo">
                <sheet>
                    <div class="alert alert-warning text-center" role="alert" invisible="not requires_accounting_asset">
                        <strong>¡Atención Contable!</strong> El valor de este activo supera el umbral configurado en UVT. Se requiere vincular o registrar un Activo Contable.
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="code" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="name" placeholder="Nombre / Descripción del Activo"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Información del Producto">
                            <field name="product_id"/>
                            <field name="brand"/>
                            <field name="reference"/>
                            <field name="product_category_id"/>
                            <field name="serial_id" domain="[('product_id', '=', product_id)]" context="{'default_product_id': product_id}"/>
                        </group>
                        <group string="Asignación y Ubicación">
                            <field name="employee_id"/>
                            <field name="analytic_account_id"/>
                            <field name="location_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Valoración y Contabilidad">
                            <field name="purchase_value"/>
                            <field name="requires_accounting_asset" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas e Historial">
                            <field name="notes" placeholder="Observaciones generales sobre el estado del activo..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="view_ienel_asset_kanban" model="ir.ui.view">
        <field name="name">ienel.asset.kanban</field>
        <field name="model">ienel.asset</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="product_id"/>
                <field name="employee_id"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <div class="me-2">
                                <field name="image" widget="image" options="{'zoom': true, 'preview_image': 'image'}" class="o_kanban_image"/>
                            </div>
                            <div class="flex-grow-1">
                                <strong class="o_kanban_record_title"><field name="code"/> - <field name="name"/></strong>
                                <div><span class="text-muted">Producto: </span><field name="product_id"/></div>
                                <div><span class="text-muted">Responsable: </span><field name="employee_id"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_ienel_asset" model="ir.actions.act_window">
        <field name="name">Activos Fijos</field>
        <field name="res_model">ienel.asset</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_ienel_asset_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primer Activo Fijo!
            </p>
            <p>
                Gestiona y realiza el seguimiento de activos fijos, números de serie y centros de costo.
            </p>
        </field>
    </record>
</odoo>