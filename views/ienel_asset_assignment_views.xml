<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Lista de Pertenencias -->
    <record id="view_ienel_asset_assignment_tree" model="ir.ui.view">
        <field name="name">ienel.asset.assignment.list</field>
        <field name="model">ienel.asset.assignment</field>
        <field name="arch" type="xml">
            <list string="Historial de Pertenencias">
                <field name="asset_id"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-warning="state == 'pending_clearance'" decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario de Pertenencia -->
    <record id="view_ienel_asset_assignment_form" model="ir.ui.view">
        <field name="name">ienel.asset.assignment.form</field>
        <field name="model">ienel.asset.assignment</field>
        <field name="arch" type="xml">
            <form string="Pertenencia de Activo">
                <header>
                    <button name="action_activate" string="Asignar" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,pending_clearance,closed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Datos de la Pertenencia">
                            <field name="asset_id" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Fechas de Control">
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="end_date" readonly="state == 'closed'"/>
                        </group>
                    </group>
                    <group string="Contratos y Documentos">
                        <field name="comodato_signed" readonly="state != 'draft'"/>
                        <field name="paz_y_salvo_signed" invisible="state in ('draft', 'active')" readonly="state == 'closed'"/>
                    </group>
                    <group string="Observaciones" invisible="state in ('draft', 'active')">
                        <field name="notes" placeholder="Escribe observaciones sobre la devolución del activo..." readonly="state == 'closed'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>