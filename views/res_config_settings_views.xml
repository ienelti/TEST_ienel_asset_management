<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulario de Ajustes Heredado -->
    <record id="res_config_settings_view_form_ienel_asset" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ienel.asset</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Activos Fijos" 
                     string="Activos Fijos" 
                     name="TEST_ienel_asset_management" 
                     groups="TEST_ienel_asset_management.group_ienel_asset_admin">
                    
                    <block title="Gestión de Alertas (Mantenimientos y Calibraciones)" name="asset_alerts_setting_container">
                        <setting id="enable_asset_alerts_setting" 
                                 help="Activa el motor automático de generación de actividades y recordatorios de fechas límites.">
                            <field name="enable_asset_alerts"/>
                        </setting>

                        <setting id="alert_days_setting" 
                                 help="Define los días de anticipación estándar para emitir la 1.ª, 2.ª y 3.ª alerta." 
                                 invisible="not enable_asset_alerts">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="alert_days_1" class="col-lg-4 o_light_label" string="1.ª Alerta (Días antes)"/>
                                    <field name="alert_days_1"/>
                                </div>
                                <div class="row mt16">
                                    <label for="alert_days_2" class="col-lg-4 o_light_label" string="2.ª Alerta (Días antes)"/>
                                    <field name="alert_days_2"/>
                                </div>
                                <div class="row mt16">
                                    <label for="alert_days_3" class="col-lg-4 o_light_label" string="3.ª Alerta (Días antes)"/>
                                    <field name="alert_days_3"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Acción de Ventana para Ajustes -->
    <record id="action_ienel_asset_config_settings" model="ir.actions.act_window">
        <field name="name">Ajustes de Activos Fijos</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'TEST_ienel_asset_management', 'bin_size': False}</field>
    </record>

</odoo>