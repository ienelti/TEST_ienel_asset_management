<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Lista de Mantenimientos -->
    <record id="view_ienel_asset_maintenance_tree" model="ir.ui.view">
        <field name="name">ienel.asset.maintenance.list</field>
        <field name="model">ienel.asset.maintenance</field>
        <field name="arch" type="xml">
            <list string="Mantenimientos de Activos Fijos">
                <field name="asset_id"/>
                <field name="maintenance_date"/>
                <field name="maintenance_type"/>
                <field name="next_maintenance_date"/>
                <field name="cost" widget="monetary"/>
                <button name="action_open_internal_preview" string="Ver documento" type="object" icon="fa-eye" invisible="not onedrive_item_id"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario de Mantenimiento -->
    <record id="view_ienel_asset_maintenance_form" model="ir.ui.view">
        <field name="name">ienel.asset.maintenance.form</field>
        <field name="model">ienel.asset.maintenance</field>
        <field name="arch" type="xml">
            <form string="Registro de Mantenimiento">
                <sheet>
                    <group>
                        <group string="Información del Mantenimiento">
                            <field name="asset_id"/>
                            <field name="maintenance_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="cost"/>
                        </group>
                        <group string="Fechas y Soportes">
                            <field name="maintenance_date"/>
                            <field name="next_maintenance_date"/>
                            <field name="certificate_file" filename="certificate_filename" string="Cargar Soporte"/>
                            <field name="certificate_filename" readonly="1"/>
                            <button name="action_open_internal_preview" string="Ver Soporte" type="object" icon="fa-eye" invisible="not onedrive_item_id"/>
                        </group>
                    </group>
                    <group string="Observaciones">
                        <field name="notes" placeholder="Escriba aquí detalles del mantenimiento." nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista Búsqueda / Filtros de Mantenimientos -->
    <record id="view_ienel_asset_maintenance_search" model="ir.ui.view">
        <field name="name">ienel.asset.maintenance.search</field>
        <field name="model">ienel.asset.maintenance</field>
        <field name="arch" type="xml">
            <search string="Buscar Mantenimientos">
                <field name="asset_id"/>
                <field name="maintenance_type"/>
                <filter string="Preventivos" name="preventive" domain="[('maintenance_type', '=', 'preventive')]"/>
                <filter string="Correctivos" name="corrective" domain="[('maintenance_type', '=', 'corrective')]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Activo Fijo" name="group_by_asset" context="{'group_by': 'asset_id'}"/>
                    <filter string="Tipo de Mantenimiento" name="group_by_type" context="{'group_by': 'maintenance_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana General de Mantenimientos -->
    <record id="action_ienel_asset_maintenance" model="ir.actions.act_window">
        <field name="name">Mantenimientos</field>
        <field name="res_model">ienel.asset.maintenance</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>