<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista de Tipos de Documento -->
    <record id="view_ienel_asset_document_type_tree" model="ir.ui.view">
        <field name="name">ienel.asset.document.type.list</field>
        <field name="model">ienel.asset.document.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de Documento" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_ienel_asset_document_type" model="ir.actions.act_window">
        <field name="name">Tipos de Documento</field>
        <field name="res_model">ienel.asset.document.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú en Configuración -->
    <menuitem id="menu_ienel_asset_document_type"
              name="Tipos de Documento"
              parent="menu_ienel_asset_config"
              action="action_ienel_asset_document_type"
              sequence="20"/>
</odoo>