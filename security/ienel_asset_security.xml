<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Rol 1: Usuario de Activos Fijos -->
    <record id="group_ienel_asset_user" model="res.groups">
        <field name="name">Usuario de Activos Fijos</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Acceso de lectura e interacción básica para usuarios de activos fijos.</field>
    </record>

    <!-- Rol 2: Encargado de Activos Fijos -->
    <record id="group_ienel_asset_manager" model="res.groups">
        <field name="name">Encargado de Activos Fijos</field>
        <field name="implied_ids" eval="[(4, ref('group_ienel_asset_user'))]"/>
        <field name="comment">Gestión operativa del módulo y destinatario de alertas de mantenimientos y calibraciones.</field>
    </record>

    <!-- Rol 3: Administrador de Activos Fijos -->
    <record id="group_ienel_asset_admin" model="res.groups">
        <field name="name">Administrador de Activos Fijos</field>
        <field name="implied_ids" eval="[(4, ref('group_ienel_asset_manager'))]"/>
        <field name="comment">Acceso completo de gestión, configuración y administración de activos fijos.</field>
    </record>

</odoo>